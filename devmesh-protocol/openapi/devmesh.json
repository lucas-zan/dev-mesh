        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Record": {
        "type": "object",
        "additionalProperties": true
      },
      "Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
