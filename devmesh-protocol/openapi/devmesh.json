          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Command": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "steer",
              "follow_up",
              "prompt",
              "interrupt"
            ]
          },
          "message": {
            "type": "string"
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "target": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string"
              },
              "work_id": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
