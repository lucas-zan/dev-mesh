              }
            },
            "required": [
              "project_id",
              "work_id",
              "session_id",
              "runtime_instance_id",
              "expected_run_epoch",
              "claim_generation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "target"
        ],
        "additionalProperties": false
      },
      "Comment": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "work_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    }
