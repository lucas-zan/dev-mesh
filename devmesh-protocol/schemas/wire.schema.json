{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.devmesh.invalid/1.1/wire.schema.json",
  "$defs": {
    "issue_ref": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "instance_id",
        "repository_id",
        "issue_number"
      ],
      "additionalProperties": false
    },
    "content_policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "redacted": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "omitted": {
          "type": "boolean"
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "policy_id",
        "redacted",
        "truncated",
        "omitted",
        "original_bytes"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "message_events": {
          "type": "boolean"
        },
        "tool_events": {
          "type": "boolean"
        },
        "steer": {
          "type": "boolean"
        },
        "follow_up": {
          "type": "boolean"
        },
        "prompt": {
          "type": "boolean"
        },
        "interrupt": {
          "type": "boolean"
        },
        "local_approval": {
          "type": "boolean"
        },
        "local_input": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "child_sessions": {
          "type": "boolean"
        }
      },
      "required": [
        "message_events",
        "tool_events",
        "steer",
        "follow_up",
        "prompt",
        "interrupt",
        "local_approval",
        "local_input",
        "resume",
        "child_sessions"
      ],
      "additionalProperties": false
    },
    "remote_control": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allow_steer": {
          "type": "boolean"
        },
        "allow_follow_up": {
          "type": "boolean"
        },
        "allow_prompt": {
          "type": "boolean"
        },
        "allow_interrupt": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "allow_steer",
        "allow_follow_up",
        "allow_prompt",
        "allow_interrupt"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "work_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "event_id",
        "work_id",
        "session_id",
        "sequence",
        "occurred_at",
        "run_epoch",
        "type",
        "payload"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "work.state"
            },
            "payload": {
              "type": "object",
              "properties": {
                "previous": {
                  "anyOf": [
                    {
                      "enum": [
                        "preparing",
                        "active",
                        "recovery_required",
                        "finalizing",
                        "completed",
                        "blocked",
                        "failed",
                        "cancelled"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "enum": [
                    "preparing",
                    "active",
                    "recovery_required",
                    "finalizing",
                    "completed",
                    "blocked",
                    "failed",
                    "cancelled"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "previous",
                "state",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "session.state"
            },
            "payload": {
              "type": "object",
              "properties": {
                "previous": {
                  "anyOf": [
                    {
                      "enum": [
                        "starting",
                        "running",
                        "idle",
                        "waiting_input",
                        "waiting_approval",
                        "stopping",
                        "ended",
                        "failed",
                        "cancelled"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "state": {
                  "enum": [
                    "starting",
                    "running",
                    "idle",
                    "waiting_input",
                    "waiting_approval",
                    "stopping",
                    "ended",
                    "failed",
                    "cancelled"
                  ]
                },
                "connection": {
                  "enum": [
                    "connecting",
                    "online",
                    "offline",
                    "reconnecting",
                    "unknown"
                  ]
                },
                "runtime_instance_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "run_epoch": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                }
              },
              "required": [
                "previous",
                "state",
                "connection",
                "runtime_instance_id",
                "run_epoch"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "turn.started"
            },
            "payload": {
              "type": "object",
              "properties": {
                "run_epoch": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "native_turn_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "run_epoch",
                "native_turn_id"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "turn.completed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "run_epoch": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "native_turn_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outcome": {
                  "enum": [
                    "success",
                    "failed",
                    "cancelled",
                    "unknown"
                  ]
                }
              },
              "required": [
                "run_epoch",
                "native_turn_id",
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "message.completed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "author_kind": {
                  "enum": [
                    "user",
                    "agent",
                    "system"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 16384
                },
                "content_policy": {
                  "$ref": "#/$defs/content_policy"
                }
              },
              "required": [
                "message_id",
                "author_kind",
                "text",
                "content_policy"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "tool.started"
            },
            "payload": {
              "type": "object",
              "properties": {
                "tool_call_id": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 16384
                }
              },
              "required": [
                "tool_call_id",
                "tool",
                "summary"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "tool.completed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "tool_call_id": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 16384
                },
                "outcome": {
                  "enum": [
                    "success",
                    "failed",
                    "cancelled",
                    "unknown"
                  ]
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "exit_code": {
                  "type": "integer"
                },
                "output": {
                  "type": "string",
                  "maxLength": 8192
                },
                "content_policy": {
                  "$ref": "#/$defs/content_policy"
                }
              },
              "required": [
                "tool_call_id",
                "tool",
                "summary",
                "outcome",
                "duration_ms",
                "content_policy"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "file.changed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "added",
                    "modified",
                    "deleted",
                    "renamed"
                  ]
                },
                "additions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "deletions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "path",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "plan.updated"
            },
            "payload": {
              "type": "object",
              "properties": {
                "plan_id": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 16384
                      },
                      "status": {
                        "enum": [
                          "pending",
                          "running",
                          "done",
                          "blocked"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "text",
                      "status"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "plan_id",
                "steps"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "delivery.reported"
            },
            "payload": {
              "type": "object",
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "minItems": 1
                },
                "candidate_sha": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outcome": {
                  "enum": [
                    "pass",
                    "fail",
                    "incomplete"
                  ]
                }
              },
              "required": [
                "evidence_ids",
                "candidate_sha",
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "approval.requested"
            },
            "payload": {
              "type": "object",
              "properties": {
                "approval_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "enum": [
                    "approval",
                    "input"
                  ]
                },
                "deadline": {
                  "type": "string",
                  "format": "date-time"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 16384
                }
              },
              "required": [
                "approval_id",
                "kind",
                "deadline",
                "summary"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "approval.resolved"
            },
            "payload": {
              "type": "object",
              "properties": {
                "approval_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "enum": [
                    "approval",
                    "input"
                  ]
                },
                "outcome": {
                  "enum": [
                    "approved",
                    "denied",
                    "answered",
                    "expired",
                    "cancelled",
                    "unknown"
                  ]
                }
              },
              "required": [
                "approval_id",
                "kind",
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "usage.updated"
            },
            "payload": {
              "type": "object",
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "scope": {
                  "enum": [
                    "turn",
                    "session"
                  ]
                },
                "cached_input_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "input_tokens",
                "output_tokens",
                "scope"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "capture.gap"
            },
            "payload": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                },
                "dropped_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "source_range": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "reason",
                "dropped_count",
                "source_range"
              ],
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^x\\.[a-z0-9._-]+$"
            },
            "payload": {
              "type": "object"
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "work_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "runtime_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_run_epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "project_id",
        "work_id",
        "session_id",
        "runtime_instance_id",
        "claim_generation",
        "expected_run_epoch"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "sender_id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "enum": [
            "steer",
            "follow_up",
            "prompt",
            "interrupt"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "message": {
          "type": "string",
          "maxLength": 16384
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "command_id",
        "sender_id",
        "type",
        "target",
        "message",
        "issued_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "receipt_seq": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "state": {
          "enum": [
            "pending",
            "delivered",
            "accepted",
            "applied",
            "rejected",
            "expired",
            "cancelled",
            "unknown"
          ]
        },
        "disposition": {
          "enum": [
            "none",
            "queued",
            "handled",
            "native_accepted"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "command_id",
        "receipt_seq",
        "state",
        "disposition",
        "reason_code",
        "evidence_ref",
        "at"
      ],
      "additionalProperties": false
    },
    "catalog_item": {
      "type": "object",
      "properties": {
        "issue_ref": {
          "$ref": "#/$defs/issue_ref"
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_state": {
          "enum": [
            "open",
            "closed",
            "unavailable",
            "deleted"
          ]
        },
        "canonical_state": {
          "anyOf": [
            {
              "enum": [
                "backlog",
                "ready",
                "claimed",
                "running",
                "review",
                "blocked",
                "rework",
                "done"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "backend",
                "frontend",
                "product",
                "qa"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "p0",
                "p1",
                "p2",
                "p3"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "issue_ref",
        "source_updated_at",
        "content_version",
        "metadata_hash",
        "source_state",
        "canonical_state",
        "role",
        "assignees",
        "title",
        "url",
        "priority"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 16384
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "version": {
      "const": "1.1"
    },
    "type": {
      "type": "string"
    },
    "frame_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "reply_to": {
      "type": "string",
      "format": "uuid"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "version",
    "type",
    "frame_id",
    "sent_at",
    "payload"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "connection.register"
        },
        "payload": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "format": "uuid"
            },
            "supported_versions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "client_version": {
              "type": "string"
            },
            "resume_sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "acked_sequence": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  }
                },
                "required": [
                  "session_id",
                  "acked_sequence"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "device_id",
