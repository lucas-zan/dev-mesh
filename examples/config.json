{
  "schema_version": 1,
  "device_id": "11111111-1111-4111-8111-111111111111",
  "roles": [
    "backend",
    "frontend",
    "product",
    "qa"
  ],
  "gitea": {
    "endpoint": "http://git.meditrust.xyz",
    "credential_ref": "env:GITEA_TOKEN",
    "mcp_program": "gitea-mcp"
  },
  "relay": {
    "endpoint": "http://127.0.0.1:17843",
    "credential_ref": "env:DEVMESH_RELAY_KEY"
  },
  "state_dir": "/absolute/path/to/devmesh-state",
  "projects": [],
  "worker": {
    "enabled": false,
    "max_concurrency": 2,
    "poll_interval_seconds": 30,
    "idle_grace_seconds": 120,
    "approval_timeout_seconds": 900,
    "input_timeout_seconds": 1800
  },
  "remote_control": {
    "enabled": false,
    "allow_interrupt": false
  },
  "repositories": {
    "instance_id": "22222222-2222-4222-8222-222222222222",
    "workspace_root": "/absolute/path/to/devmesh-workspaces",
    "runtime": "codex",
    "auto_claim": false,
    "test_commands": []
  }
}
